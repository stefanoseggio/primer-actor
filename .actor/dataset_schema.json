{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "actorSpecification": 1,
    "title": "Dataset Schema",
    "fields": {
        "type": "object",
        "properties": {
            "title": {
                "title": "Title",
                "type": "string",
                "description": "Page title"
            },
            "url": {
                "title": "URL",
                "type": "string",
                "description": "Page URL"
            },
            "scrapedAt": {
                "title": "Scraped At",
                "type": "string",
                "description": "Timestamp of scraping"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "title",
                    "url",
                    "scrapedAt"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    {
                        "label": "Title",
                        "format": "text",
                        "field": "title"
                    },
                    {
                        "label": "URL",
                        "format": "link",
                        "field": "url"
                    },
                    {
                        "label": "Scraped At",
                        "format": "date",
                        "field": "scrapedAt"
                    }
                ]
            }
        }
    }
}