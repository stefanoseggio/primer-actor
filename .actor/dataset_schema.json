{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "actorSpecification": 1,
    "title": "Dataset Schema",
    "fields": {
        "type": "object",
        "properties": {
            "url": { "title": "URL", "type": "string", "description": "Page URL" },
            "title": { "title": "Title", "type": "string", "description": "Page title tag" },
            "metaDescription": { "title": "Meta description", "type": ["string", "null"], "description": "meta name=description content" },
            "canonicalUrl": { "title": "Canonical URL", "type": ["string", "null"], "description": "link rel=canonical href" },
            "ogTitle": { "title": "OG title", "type": ["string", "null"], "description": "og:title meta content" },
            "ogImage": { "title": "OG image", "type": ["string", "null"], "description": "og:image meta content" },
            "language": { "title": "Language", "type": ["string", "null"], "description": "html lang attribute" },
            "h1": { "title": "H1", "type": ["string", "null"], "description": "First h1 text" },
            "wordCount": { "title": "Word count", "type": "integer", "description": "Approximate visible body word count" },
            "statusCode": { "title": "Status code", "type": ["integer", "null"], "description": "HTTP status code of the response" },
            "crawlDepth": { "title": "Crawl depth", "type": "integer", "description": "Link-hops from the nearest start URL" },
            "scrapedAt": { "title": "Scraped at", "type": "string", "description": "ISO timestamp of extraction" },
            "eventType": { "title": "Event type", "type": "string", "enum": ["NEW_URL", "CONTENT_CHANGED", "UNCHANGED"], "description": "NEW_URL if this exact URL was never scraped before, CONTENT_CHANGED if its metadata differs from the last scrape, UNCHANGED otherwise. No status/closure concept applies - this Actor crawls caller-supplied URLs, not a discoverable listing registry." },
            "contentHash": { "title": "Content hash", "type": "string", "description": "Fingerprint over the page's extracted content fields, used to detect CONTENT_CHANGED across runs." },
            "previousScrapedAt": { "title": "Previously scraped at", "type": ["string", "null"], "description": "scrapedAt from the last time this URL was scraped, or null if this is the first time (NEW_URL)." }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["title", "url", "statusCode", "wordCount", "scrapedAt"]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "Title", "format": "text", "field": "title" },
                    { "label": "URL", "format": "link", "field": "url" },
                    { "label": "Status", "format": "text", "field": "statusCode" },
                    { "label": "Words", "format": "number", "field": "wordCount" },
                    { "label": "Scraped At", "format": "date", "field": "scrapedAt" }
                ]
            }
        },
        "changes": {
            "title": "Change detection",
            "transformation": {
                "fields": ["url", "eventType", "previousScrapedAt", "scrapedAt", "contentHash"]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "URL", "format": "link", "field": "url" },
                    { "label": "Event", "format": "text", "field": "eventType" },
                    { "label": "Previously scraped at", "format": "date", "field": "previousScrapedAt" },
                    { "label": "Scraped at", "format": "date", "field": "scrapedAt" },
                    { "label": "Content hash", "format": "text", "field": "contentHash" }
                ]
            }
        }
    }
}
